rules_version = '2';

// Adaptive Study Path Engine - Cloud Firestore security rules (NFR-S4)
// Paste into Firebase console -> Firestore Database -> Rules -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // A student can only read/write their own profile + progress document.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Diagnostic submissions are append-only history.
      match /diagnosticQuizzes/{quizId} {
        allow read, create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
